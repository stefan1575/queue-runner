{
  "name": "queue-runner-app",
  "productName": "Queue runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "desktop": "pnpm desktop:build && electron .",
    "desktop:build": "vite build --config renderer/vite.config.ts --logLevel warn && esbuild src/desktop/electron.ts --bundle --platform=node --format=esm --external:electron --outfile=desktop-dist/main.mjs --log-level=warning && esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop-dist/preload.cjs --log-level=warning",
    "desktop:shoot": "pnpm desktop:build && electron . --shoot",
    "installer": "pnpm desktop:build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p renderer",
    "test": "vitest run",
    "live:sign-in": "node live/sign-in.ts",
    "live:launch": "node live/launch.ts",
    "live:usage": "node live/usage.ts",
    "live:build": "node live/build.ts",
    "live:review": "node live/review.ts",
    "live:merge": "node live/merge.ts",
    "live:conflict": "node live/conflict.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "^3.2.7"
  }
}
